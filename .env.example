# ── App ──────────────────────────────────────────────
APP_NAME=LinkedOps
APP_ENV=development
# Set APP_ENV=test when running pytest — this disables the background
# scheduler so jobs don't fire mid-test-run against your test data.
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-minimum-32-chars
FRONTEND_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/linkedops

# ── JWT ──────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-another-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LinkedIn OAuth ───────────────────────────────────
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/linkedin/callback

# ── OpenRouter (AI) ──────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=mistralai/mistral-7b-instruct

# ── Encryption (for LinkedIn tokens) ────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here
